{
  "openapi": "3.1.0",
  "info": {
    "title": "DNSY REST API",
    "description": "Management API of the DNSY DNS server. Errors are RFC 9457 problem+json.",
    "license": {
      "name": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/version": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "The server version.",
        "operationId": "version",
        "responses": {
          "200": {
            "description": "Version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "The process is up.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "The process can serve requests (the database answers).",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem document.",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Explanation specific to this occurrence. Never contains secrets."
          },
          "retry_after_secs": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Seconds to wait before retrying (only on 429).",
            "minimum": 0
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short, human-readable summary of the problem type."
          },
          "type": {
            "type": "string",
            "description": "URI identifying the problem type."
          }
        }
      },
      "Status": {
        "type": "object",
        "description": "Liveness/readiness answer.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "`ok` or `ready`."
          }
        }
      },
      "Version": {
        "type": "object",
        "description": "Build information.",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string",
            "description": "`dnsy` crate version."
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "dnsy_..."
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dnsy_session"
      }
    }
  }
}
