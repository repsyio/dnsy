{
  "name": "dnsy",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "pnpm sync:branding && ng serve",
    "build": "pnpm sync:branding && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "lint": "ng lint && prettier --check .",
    "e2e": "tsc -p e2e/tsconfig.json && playwright test",
    "types": "openapi-typescript ../openapi/dnsy.json -o src/app/api/schema.d.ts",
    "format": "prettier --write .",
    "postbuild": "node scripts/compress-dist.mjs",
    "sync:branding": "node scripts/sync-branding.mjs"
  },
  "private": true,
  "packageManager": "pnpm@10.16.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "three": "0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": "6"
      }
    },
    "overrides": {
      "vite": ">=8.3.3"
    }
  }
}
